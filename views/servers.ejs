<%- include('overall_header'); %>

<% [['Official Servers', 'official_servers', official_servers, true], ['Community Servers', 'community_servers', community_servers, false]].forEach(([title, id, list, showTag]) => { %>
<% if (showTag) { %><h1><%= title %></h1><% } else { %><h2><%= title %></h2><% } %>
<div id="<%= id %>" class="responsive">
  <table class="sortable maxwidth big">
    <thead>
      <tr>
        <th class="no-sort sv-flag"></th>
        <th width="34%">Name</th>
        <th width="8%" class="dir-d">Players</th>
        <th width="13%" class="sv-hide-mobile">Arena</th>
        <th width="12%" class="sv-hide-mobile">Mode</th>
        <th width="19%" class="sv-hide-mobile">Address</th>
        <th width="14%" class="no-sort">Connect</th>
      </tr>
    </thead>
    <tbody>
      <% if (Object.keys(list).length === 0) { %>
      <tr class="empty-row"><td colspan="7">-- no servers online --</td></tr>
      <% } %>
      <% Object.values(list).forEach(v => { %>
      <tr>
        <td class="sv-flag"><%= v.flag %></td>
        <td data-sort="<%= v.name %>"><% if (showTag) { %><% if (v.is_ranked) { %><span class="sv-tag ranked-tag">RANKED</span><% } else { %><span class="sv-tag">CASUAL</span><% } %> <% } %><% if (v.require_password) { %><span class="sv-tag" title="Password"><i class="fa-solid fa-lock"></i></span> <% } %><a class="sv-name" href="/servers/<%= v.site_displayed_address %>"><%= v.name %></a><% if (/^https?:\/\//.test(v.tournament_page || "")) { %> <a class="sv-tag sv-results" href="<%= v.tournament_page %>" target="_blank" rel="noopener" title="The tournament's live results"><i class="fa-solid fa-trophy"></i> Results</a><% } %></td>
        <% const humans = Number(v.num_online_humans) || 0; %>
        <td data-sort="<%= humans %>" class="<%= humans > 0 ? 'online' : 'dimmed' %>"><%= humans %>/<%= v.max_online %></td>
        <td class="sv-hide-mobile"><% if (hasArena(v.arena)) { %><a class="arena-link" href="/arenas/<%= v.arena %>"><%= v.arena %></a><% } else { %><%= v.arena %><% } %></td>
        <td class="sv-hide-mobile"><%= v.game_mode %></td>
        <% const keyed = (typeof v.server_public_key === 'string' && /^[0-9a-f]{64}$/.test(v.server_public_key)) ? ',' + v.server_public_key : ''; %>
        <td class="sv-hide-mobile sv-address" data-sort="<%= v.site_displayed_address %>"><button type="button" class="copy-btn" data-copy="<%= shownAddress(v.site_displayed_address) %><%= keyed %>" title="Copy the address with the server's key" aria-label="Copy the address with the server's key"><i class="fa-regular fa-copy"></i></button><span><%= shownAddress(v.site_displayed_address) %></span></td>
        <td class="sv-actions">
          <a href="steam://run/2660970//<%= shownAddress(v.site_displayed_address) %><%= keyed %>/" title="Connect via Steam"><i class="fa-brands fa-steam"></i>Steam</a>
          <a href="https://play.hypersomnia.io/game/<%= v.browser_connect_string %><%= keyed %>" title="Play in Browser"><i class="fa-solid fa-right-to-bracket"></i>Browser</a>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<% }); %>

<%- include('overall_footer'); %>
