<%- include('overall_header'); %>

<% [['Official Servers', 'official_servers', official_servers, true], ['Community Servers', 'community_servers', community_servers, false]].forEach(([title, id, list, showTag]) => { %>
<% if (showTag) { %><h1><%= title %></h1><% } else { %><h2><%= title %></h2><% } %>
<div id="<%= id %>" class="responsive">
  <table class="sortable maxwidth big">
    <thead>
      <tr>
        <th class="no-sort sv-flag"></th>
        <th width="34%">Name</th>
        <th width="8%" class="dir-d">Players</th>
        <th width="13%" class="sv-hide-mobile">Arena</th>
        <th width="12%" class="sv-hide-mobile">Mode</th>
        <th width="19%" class="sv-hide-mobile">Address</th>
        <th width="14%" class="no-sort">Connect</th>
      </tr>
    </thead>
    <tbody>
      <% if (list.length === 0) { %>
      <tr class="empty-row"><td colspan="7">-- no servers online --</td></tr>
      <% } %>
      <% list.forEach(row => { %>
      <% if (row.server) { %>
      <%- include('server_row', { v: row.server, showTag, group: null, colored: false }); %>
      <% } else { const t = row.tournament; const colored = t.is_official; %>
      <tr class="sv-tournament<%= t.finished ? ' finished' : '' %>" data-tournament="<%= t.id %>">
        <td class="sv-flag"><%= t.flag %></td>
        <td data-sort="<%= t.name %>"><span class="sv-tag<%= t.finished ? ' finished-tag' : (colored ? ' ranked-tag' : '') %>"><%= t.finished ? 'FINISHED' : 'TOURNAMENT' %></span> <span class="sv-name"><%= t.name %></span><% if (t.tournament_page) { %> <a class="sv-tag sv-results" href="<%= t.tournament_page %>" target="_blank" rel="noopener" title="<%= t.tournament_page %>"><i class="fa-solid fa-trophy"></i> Results</a><% } %></td>
        <td data-sort="<%= t.humans %>" class="<%= t.humans > 0 ? 'online' : 'dimmed' %>"><%= t.humans %>/<%= t.max_online %></td>
        <td class="sv-hide-mobile"></td>
        <td class="sv-hide-mobile"></td>
        <td class="sv-hide-mobile"></td>
        <td class="sv-actions"></td>
      </tr>
      <% if (!t.finished) { t.entries.forEach(v => { %>
      <%- include('server_row', { v, showTag, group: t.id, colored }); %>
      <% }); } %>
      <% } %>
      <% }); %>
    </tbody>
  </table>
</div>
<% }); %>

<%- include('overall_footer'); %>
