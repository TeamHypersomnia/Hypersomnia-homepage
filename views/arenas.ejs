<%- include('overall_header'); %>

<div class="section-head">
  <h2>Community Arenas</h2>
  <div class="view-switch">
    <button type="button" data-view="list" class="active">List</button>
    <button type="button" data-view="grid">Grid</button>
  </div>
</div>

<div class="responsive arena-view" data-view="list">
  <table class="sortable arena-table">
    <thead>
      <tr>
        <th class="no-sort"></th>
        <th class="dir-u">Name</th>
        <th>Author</th>
        <th class="no-sort">Description</th>
        <th>Last updated</th>
        <th class="sv-hide-mobile">Size</th>
      </tr>
    </thead>
    <tbody>
      <% arenas.forEach(v => { %>
      <tr>
        <td class="arena-thumb"><a href="/arenas/<%= v.name %>"><img src="/arenas/<%= v.name %>/miniature.png?t=<%= v.ts %>" alt="<%= v.name %>" loading="lazy"></a></td>
        <td class="arena-title"><a href="/arenas/<%= v.name %>"><%= v.name %></a></td>
        <td><%= v.author %></td>
        <td class="arena-desc"><% if (v.short_description !== 'N/A') { %><%= v.short_description %><% } else { %><span class="dimmed">-</span><% } %></td>
        <td data-sort="<%= v.ts %>"><%= v.updated %></td>
        <td class="sv-hide-mobile" data-sort="<%= parseFloat(v.size) %>"><%= v.size %></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<div class="arenas arena-view" data-view="grid" hidden>
<% arenas.forEach(v => { %>
  <a href="/arenas/<%= v.name %>">
    <img src="/arenas/<%= v.name %>/miniature.png?t=<%= v.ts %>" alt="<%= v.name %>" loading="lazy">
    <div class="arena_name"><%= v.name %></div>
    <div class="arena_author"><%= v.author %></div>
  </a>
<% }); %>
</div>

<%- include('overall_footer'); %>
