<%- include('overall_header'); %>
<h1><% if (hasAvatar) { %><img class="avatar" src="/avatar/<%= userid %>.png" alt=""> <% } %><%= nickname %></h1>

<div class="box">
  <div class="responsive">
    <table class="big">
      <thead>
        <tr>
          <th colspan="2">Details</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td width="50%"><%= userid.startsWith('key_') ? 'Public key' : 'External profile' %></td>
          <td width="50%">
            <% if (userid.startsWith('key_')) { %>
              <%# A key has no profile elsewhere - its public key, shown only here: short, copied in full %>
              <i class="<%= platformIconClass %>"></i><span class="account-key" title="<%= fullAccountId(userid) %>"><%= accountLabel(userid) %></span><button type="button" class="copy-btn" data-copy="<%= fullAccountId(userid) %>" title="Copy the public key" aria-label="Copy the public key"><i class="fa-regular fa-copy"></i></button>
            <% } else if (!profileUrl) { %>
              <i class="<%= platformIconClass %>"></i><%= platformName %> (no external profile)
            <% } else { %>
            <a href="<%= profileUrl %>" target="_blank">
              <% if (platformName === 'CrazyGames') { %>
                <img class="fa-brands rank" src="/assets/images/social_crazygames.png" alt="CrazyGames"><%= platformName %>
              <% } else { %>
                <i class="<%= platformIconClass %>"></i><%= platformName %>
              <% } %>
            </a>
            <% } %>
          </td>
        </tr>
        <% if (linkedTo) { %>
        <tr>
          <td>Plays as</td>
          <td><a href="/user/<%= linkedTo %>"><%= linkedToName %></a></td>
        </tr>
        <% } else if (secondaryAccounts.length > 0) { %>
        <%# one row per secondary account, the label only in the first %>
        <% secondaryAccounts.forEach(function(account, i) { %>
        <tr>
          <td><%= i === 0 ? 'Secondary accounts' : '' %></td>
          <td><a href="/user/<%= account.id %>"><%= account.nickname %></a></td>
        </tr>
        <% }); %>
        <% } %>
        <% if (playedAny) { %>
        <tr>
          <td><abbr title="Match Making Rating">MMR</abbr> (Bomb Defusal)</td>
          <td>
            <img class="rank" src="<%= gfx('necessary/' + teamData.rankImg) %>" alt="<%= teamData.rankName %>"><abbr title="μ = <%= teamData.mu.toFixed(3) %> / σ = <%= teamData.sigma.toFixed(3) %>"><%= teamData.mmr.toFixed(2) %></abbr>
          </td>
        </tr>
        <tr>
          <td><abbr title="Match Making Rating">MMR</abbr> (FFA Gun Game)</td>
          <td>
            <img class="rank" src="<%= gfx('necessary/' + ffaData.rankImg) %>" alt="<%= ffaData.rankName %>"><abbr title="μ = <%= ffaData.mu.toFixed(3) %> / σ = <%= ffaData.sigma.toFixed(3) %>"><%= ffaData.mmr.toFixed(2) %></abbr>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <% if (playedAny) { %>
  <div class="responsive">
    <table class="big">
      <thead>
        <tr>
          <th colspan="2">Results</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td width="50%">Most Played Arena</td>
          <td width="50%"><abbr title="<%= mostPlayedArenaCount %> matches played"><%= mostPlayedArena %></abbr></td>
        </tr>
        <tr>
          <td>Longest Win Streak</td>
          <td><%= longestWinStreak %></td>
        </tr>
        <tr>
          <td><abbr title="Wins-Losses">W-L</abbr> (Bomb Defusal)</td>
          <td><%= teamData.matches_won %>-<%= teamData.matches_lost %></td>
        </tr>
        <tr>
          <td><abbr title="Wins-Losses">W-L</abbr> (FFA Gun Game)</td>
          <td><%= ffaData.matches_won %>-<%= ffaData.matches_lost %></td>
        </tr>
      </tbody>
    </table>
  </div>
  <% } %>
</div>

<% if (!playedAny) { %>
<p>This user has not played any match yet.</p>
<% } else { %>
<div class="responsive">
  <table class="sortable maxwidth big">
    <thead>
      <tr>
        <th class="dir-d shrink">When</th>
        <th width="23%">Arena</th>
        <th width="29%"><abbr title="Match Making Rating">MMR</abbr></th>
        <th class="no-sort" width="12%">Score</th>
        <th class="no-sort" width="29%">Opponents</th>
        <th width="7%">Server</th>
      </tr>
    </thead>
    <tbody>
      <% matches.forEach(v => { %>
        <tr>
          <td class="shrink time-ago"><%= v.time_ago %></td>
          <td><% if (hasArena(v.arena)) { %><a class="arena-link" href="/arenas/<%= v.arena %>"><%= v.arena %></a><% } else { %><%= v.arena %><% } %></td>
          <td class="serif"><%- formatMMRDelta(v.mmrDelta) %> <%= v.new_mmr %></td>
          <td class="serif"><% if (v.game_mode === 'FFA Gun Game') { %>FFA<% } else { %><%- v.result %><% } %></td>
          <td>
            <% v.opponentArray.forEach(player => { %>
              <%- formatMMRDelta(player.mmr_delta) %>
              <a href="/user/<%= player.id %>">
                <%= player.nickname %>
              </a>
              <% if (v.opponentArray.indexOf(player) < v.opponentArray.length - 1) { %><br><% } %>
            <% }); %>
          </td>
          <td class="extra"><%= v.server_emoji %><% if (v.multPreffix !== 1) { %><abbr class="flame" title="Event match multiplier x<%= v.multPreffix %>"><i class="fa-solid fa-fire-flame-curved"></i>x<%= v.multPreffix %></abbr><% } %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<% } %>

<%- include('overall_footer'); %>
