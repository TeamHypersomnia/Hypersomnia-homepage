<%- include('overall_header'); %>

<h1><%= sv.name %></h1>
<%# A value with an icon copying it %>
<% const copyable = (value, what) => `<span>${String(value).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}</span><button type="button" class="copy-btn" data-copy="${String(value).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}" title="Copy the ${what}" aria-label="Copy the ${what}"><i class="fa-regular fa-copy"></i></button>`; %>
<div class="box">
  <div class="responsive">
    <table>
      <thead>
        <tr>
          <th colspan="2">Details</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="detail-label">Name</td>
          <td><%- copyable(sv.name, 'name') %></td>
        </tr>
        <tr>
          <td class="detail-label">IP address</td>
          <td><code><%= sv.ip %></code><button type="button" class="copy-btn" data-copy="<%= sv.ip %>" title="Copy the address" aria-label="Copy the address"><i class="fa-regular fa-copy"></i></button></td>
        </tr>
        <tr>
          <td class="detail-label">Version</td>
          <td><%- copyable(sv.server_version, 'version') %></td>
        </tr>
        <% if (typeof sv.server_public_key === 'string' && /^[0-9a-f]{64}$/.test(sv.server_public_key)) { %>
        <%# what the game checks the server by - the same as in the game's server details %>
        <tr>
          <td class="detail-label">Server public key</td>
          <%# cut in the middle where the page is too narrow - the end of a key tells keys apart too %>
          <% const full_key = '0x' + sv.server_public_key; %>
          <td class="server-key-cell"><span class="server-key" title="<%= full_key %>"><span class="server-key-start"><%= full_key.slice(0, -10) %></span><span class="server-key-end"><%= full_key.slice(-10) %></span></span><button type="button" class="copy-btn" data-copy="0x<%= sv.server_public_key %>" title="Copy the server key" aria-label="Copy the server key"><i class="fa-regular fa-copy"></i></button></td>
        </tr>
        <% } %>
        <tr>
          <td class="detail-label">First / Last Heartbeat</td>
          <td><%= sv.time_hosted_ago %> / <%= sv.time_last_heartbeat_ago %></td>
        </tr>
        <tr>
          <td class="detail-label">Arena</td>
          <td><% if (hasArena(sv.arena)) { %><a class="arena-link" href="/arenas/<%= sv.arena %>"><%= sv.arena %></a><button type="button" class="copy-btn" data-copy="<%= sv.arena %>" title="Copy the arena" aria-label="Copy the arena"><i class="fa-regular fa-copy"></i></button><% } else { %><%- copyable(sv.arena, 'arena') %><% } %></td>
        </tr>
        <tr>
          <td class="detail-label">Game mode</td>
          <td><%- copyable(sv.game_mode, 'game mode') %></td>
        </tr>
        <tr>
          <td class="detail-label">Players</td>
          <td><%= sv.num_online %>/<%= sv.max_online %></td>
        </tr>
        <tr>
          <td class="detail-label">Score</td>
          <td><%= sv.score_resistance %>-<%= sv.score_metropolis %></td>
        </tr>
        <tr>
          <td class="detail-label" rowspan="2">Join server</td>
          <% const keyed = (typeof sv.server_public_key === 'string' && /^[0-9a-f]{64}$/.test(sv.server_public_key)) ? ',' + sv.server_public_key : ''; %>
          <td><a class="sv-connect" href="steam://run/2660970//<%= sv.site_displayed_address %><%= keyed %>/"><i class="fa-brands fa-steam"></i>Connect via Steam</a></td>
        </tr>
        <tr>
          <td><a class="sv-connect" href="https://play.hypersomnia.io/game/<%= sv.browser_connect_string %><%= keyed %>"><i class="fa-solid fa-right-to-bracket"></i>Play in Browser</a></td>
      </tbody>
    </table>
  </div>
  <div class="responsive">
    <table>
      <thead>
        <tr>
          <th width="50%">Name</th>
          <th width="25%">Score</th>
          <th width="25%">Deaths</th>
        </tr>
      </thead>
      <tbody>
        <% if (sv.num_online == 0) { %>
          <tr>
            <td colspan="3">Server is empty</td>
          </tr>
        <% } else { %>
          <% sv.players_resistance.forEach(function(v) { %>
            <tr>
              <td class="resistance"><%= v.nickname %></td>
              <td><%= v.score %></td>
              <td><%= v.deaths %></td>
            </tr>
          <% }); %>
          <% sv.players_metropolis.forEach(function(v) { %>
            <tr>
              <td class="metropolis"><%= v.nickname %></td>
              <td><%= v.score %></td>
              <td><%= v.deaths %></td>
            </tr>
          <% }); %>
          <% sv.players_spectating.forEach(function(v) { %>
            <tr>
              <td class="spectator"><%= v.nickname %></td>
              <td><%= v.score %></td>
              <td><%= v.deaths %></td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('overall_footer'); %>
