<%- include('overall_header'); %>

<h1><%= sv.name %></h1>
<%# The icons copying the values in a column of their own, between the labels and the values %>
<% const escaped = (value) => String(value).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); %>
<% const copy_cell = (value, what) => `<td class="copy-cell"><button type="button" class="copy-btn" data-copy="${escaped(value)}" title="Copy the ${what}" aria-label="Copy the ${what}"><i class="fa-regular fa-copy"></i></button></td>`; %>
<% const no_copy_cell = `<td class="copy-cell"></td>`; %>
<div class="box">
  <div class="responsive">
    <table>
      <thead>
        <tr>
          <th colspan="3">Details</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="detail-label">Name</td>
          <%- copy_cell(sv.name, 'name') %><td><%= sv.name %></td>
        </tr>
        <tr>
          <td class="detail-label">IP address</td>
          <%- copy_cell(shownAddress(sv.ip), 'address') %><td><code><%= shownAddress(sv.ip) %></code></td>
        </tr>
        <tr>
          <td class="detail-label">Version</td>
          <%- copy_cell(sv.server_version, 'version') %><td><%= sv.server_version %></td>
        </tr>
        <% if (typeof sv.server_public_key === 'string' && /^[0-9a-f]{64}$/.test(sv.server_public_key)) { %>
        <%# what the game checks the server by - the same as in the game's server details %>
        <tr>
          <td class="detail-label">Server public key</td>
          <%# cut in the middle where the page is too narrow - the end of a key tells keys apart too %>
          <% const full_key = '0x' + sv.server_public_key; %>
          <%- copy_cell(full_key, 'server key') %><td class="server-key-cell"><span class="server-key" title="<%= full_key %>"><span class="server-key-start"><%= full_key.slice(0, -10) %></span><span class="server-key-end"><%= full_key.slice(-10) %></span></span></td>
        </tr>
        <% } %>
        <tr>
          <td class="detail-label">First / Last Heartbeat</td>
          <%- no_copy_cell %><td><%= sv.time_hosted_ago %> / <%= sv.time_last_heartbeat_ago %></td>
        </tr>
        <tr>
          <td class="detail-label">Arena</td>
          <%- copy_cell(sv.arena, 'arena') %><td><% if (hasArena(sv.arena)) { %><a class="arena-link" href="/arenas/<%= sv.arena %>"><%= sv.arena %></a><% } else { %><%= sv.arena %><% } %></td>
        </tr>
        <tr>
          <td class="detail-label">Game mode</td>
          <%- copy_cell(sv.game_mode, 'game mode') %><td><%= sv.game_mode %></td>
        </tr>
        <tr>
          <td class="detail-label">Players</td>
          <%- no_copy_cell %><td><%= sv.num_online %>/<%= sv.max_online %></td>
        </tr>
        <tr>
          <td class="detail-label">Score</td>
          <%- no_copy_cell %><td><%= sv.score_resistance %>-<%= sv.score_metropolis %></td>
        </tr>
        <tr>
          <% const keyed = (typeof sv.server_public_key === 'string' && /^[0-9a-f]{64}$/.test(sv.server_public_key)) ? ',' + sv.server_public_key : ''; %>
          <% const steam_link = `steam://run/2660970//${shownAddress(sv.site_displayed_address)}${keyed}/`; %>
          <% const browser_link = `https://play.hypersomnia.io/game/${sv.browser_connect_string}${keyed}`; %>
          <td class="detail-label"></td><%- copy_cell(steam_link, 'Steam link') %><td><a class="sv-connect" href="<%= steam_link %>"><i class="fa-brands fa-steam"></i>Connect via Steam</a></td>
        </tr>
        <tr>
          <td class="detail-label"></td><%- copy_cell(browser_link, 'browser link') %><td><a class="sv-connect" href="<%= browser_link %>"><i class="fa-solid fa-right-to-bracket"></i>Play in Browser</a></td>
        </tr>
      </tbody>
    </table>
  </div>
  <div class="responsive">
    <table>
      <thead>
        <tr>
          <th width="50%">Name</th>
          <th width="25%">Score</th>
          <th width="25%">Deaths</th>
        </tr>
      </thead>
      <tbody>
        <% if (sv.num_online == 0) { %>
          <tr>
            <td colspan="3">Server is empty</td>
          </tr>
        <% } else { %>
          <% sv.players_resistance.forEach(function(v) { %>
            <tr>
              <td class="resistance"><%= v.nickname %></td>
              <td><%= v.score %></td>
              <td><%= v.deaths %></td>
            </tr>
          <% }); %>
          <% sv.players_metropolis.forEach(function(v) { %>
            <tr>
              <td class="metropolis"><%= v.nickname %></td>
              <td><%= v.score %></td>
              <td><%= v.deaths %></td>
            </tr>
          <% }); %>
          <% sv.players_spectating.forEach(function(v) { %>
            <tr>
              <td class="spectator"><%= v.nickname %></td>
              <td><%= v.score %></td>
              <td><%= v.deaths %></td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('overall_footer'); %>
